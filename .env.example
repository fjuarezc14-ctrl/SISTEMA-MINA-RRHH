# ==============================================================================
# CONFIGURACIÓN GENERAL - SISTEMA DE ONBOARDING MINERO (VALETEC)
# Puertos asignados en Host (Windows) sin conflicto con ningún otro proyecto:
# - PostgreSQL: 5450
# - Backend API: 4050
# - Frontend Web: 5150
# ==============================================================================

# Backend API
PORT=4050
NODE_ENV=development
API_PREFIX=/api

# Base de Datos PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=valetec_admin
DB_PASSWORD=valetec_secure_pass
DB_NAME=mina_onboarding_db

# JWT & Seguridad
JWT_SECRET=valetec_super_secret_jwt_key_2026
JWT_EXPIRES_IN=8h

# Almacenamiento de Archivos (CVs, EMOs, SCTR, Exámenes)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Frontend
VITE_API_URL=http://localhost:4050/api
